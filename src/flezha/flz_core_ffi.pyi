"""Type stub for the compiled veneer (``flz_core_ffi/src/python_glue.rs``).

The package ships ``py.typed``, so the native module needs a stub or every call
through it is untyped — which would quietly hollow out the checking the rest of
the surface exists to give. One declaration per export, mirroring
``NATIVE_SURFACE``.
"""

from typing import Any

class NativeError(RuntimeError):
    """A failure the native library reported."""

class SchemaMismatch(NativeError):
    """The library and this build speak different activation schema versions."""

class PayloadView:
    """A read-only buffer over bytes the veneer owns.

    Supports the buffer protocol, so a codec reads it with no intermediate
    ``bytes``; ``tobytes()`` is the explicit copy.
    """

    def __init__(self, body: bytes) -> None: ...
    def __len__(self) -> int: ...
    def tobytes(self) -> bytes: ...
    def release(self) -> None: ...

class Core:
    """The process's opaque core context."""

    def __init__(self, shim_schema_version: int) -> None: ...
    def free(self) -> None: ...
    def declare_class(self, json: bytes) -> None: ...
    def check_class(self, json: bytes) -> bytes: ...
    def start(self, namespace: str) -> None: ...
    def local_start(self, factory_id: str, operator_id: str) -> None: ...
    def local_on_sink(self, channel: str) -> None: ...
    def local_feed(self, channel: str, payload: bytes) -> None: ...
    def local_next_output(self, timeout_ms: int) -> Any: ...
    def local_run_until_idle(self, timeout_ms: int) -> None: ...
    def local_stop(self) -> None: ...
    def poll(self, timeout_ms: int) -> Any: ...
    def wait_starvation(self, timeout_ms: int) -> int: ...
    def complete(self, result: dict[str, Any]) -> None: ...
    def abandon(self, token: int) -> None: ...
    def shutdown(self) -> None: ...
    def watch_stdin_eof(self, grace_ms: int) -> None: ...
    def spawn_request(
        self, token: int, factory_id: str, id: str, payload: bytes, if_running: str, replay: bool
    ) -> int: ...
    def spawn_result(self, handle: int, timeout_ms: int) -> str | None: ...
    def admin_call(self, verb: str, args: str) -> str: ...
    def last_error(self) -> str | None: ...

def schema_version() -> int: ...
def monotonic_nanos() -> int: ...
def free_threaded() -> bool: ...
def native_surface() -> list[tuple[str, str, bool]]: ...
