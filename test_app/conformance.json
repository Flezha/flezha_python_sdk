{
  "runtime": "python",
  "sdk_lang": 7,
  "command": {
    "test": "{repo}/sdk/python/.venv/bin/python {artifact} {namespace}",
    "bench": "{repo}/sdk/python/.venv/bin/python {artifact} {namespace}"
  },
  "artifacts": {
    "test": [
      "runner.py"
    ],
    "bench": [
      "runner.py"
    ]
  },
  "build": {
    "test": "scripts/build-python-sdk.sh",
    "bench": "scripts/build-python-sdk.sh --release"
  },
  "connect_timeout_ms": 60000,
  "transports": [
    "uds",
    "quic"
  ],
  "topology_surfaces": [
    "merge",
    "branch",
    "steps",
    "untyped_tree",
    "shorthand",
    "shorthand_typed_output",
    "response",
    "call"
  ],
  "dispatch": {
    "model": "thread-pool",
    "detail": "A base pool of Python threads each looping poll/dispatch/complete on itself, plus a supervisor parked in the starvation wait; the GIL is released around every blocking core call, so it bounds only handler bodies.",
    "env": {
      "FLEZHA_WORKER_POOL_SIZE": "base worker threads (default: the host's processor count)",
      "FLEZHA_WORKER_POOL_MAX": "the ceiling the starvation supervisor grows to (default: ten times the base)",
      "FLEZHA_PYTHON_EXECUTOR": "which executor dispatches: thread (the default) or asyncio"
    }
  },
  "toolchain": "python3 --version",
  "deferred": [],
